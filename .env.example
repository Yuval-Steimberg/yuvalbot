# ─── required ────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
# Only needed if the key is an ORGANIZATION key rather than one created inside a
# workspace. Console > Settings > Workspaces gives an id like wrkspc_01ab...
# ANTHROPIC_WORKSPACE_ID=
DASHBOARD_PASSWORD=pick-something-long
SECRET_KEY=another-long-random-string
OWNER_NAME=Yuval
TIMEZONE=Asia/Jerusalem

# ─── state (Railway volume) ──────────────────────────────────────────────────
# Mount a volume at /data. Without it the agent forgets everything on redeploy.
DATA_DIR=/data
# Optional off-box backup of memory: every commit is pushed here.
# MEMORY_GIT_REMOTE=https://<user>:<token>@github.com/<you>/agent-memory.git

# ─── chat front door: Telegram (recommended) ─────────────────────────────────
TELEGRAM_BOT_TOKEN=123456:ABC...          # from @BotFather
TELEGRAM_CHAT_ID=                         # message the bot once; it replies with this
TELEGRAM_WEBHOOK_SECRET=random-string
# PUBLIC_URL is derived from RAILWAY_PUBLIC_DOMAIN automatically. Set it ONLY for
# a custom domain or a non-Railway host, and never leave an example value here:
# a placeholder registers the Telegram webhook against somebody else's domain.
# PUBLIC_URL=https://agent.yourdomain.com

# ─── chat front door: WhatsApp (optional, sandbox expires every 3 days) ──────
# TWILIO_SID=
# TWILIO_TOKEN=
# YOUR_PHONE=+9725...

# ─── Google: Gmail, Calendar, Drive, Contacts ────────────────────────────────
# python scripts/google_setup.py to mint the refresh token
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# ─── email out (optional if Gmail is connected) ──────────────────────────────
# RESEND_API_KEY=
# EMAIL_TO=you@example.com
# EMAIL_FROM=onboarding@resend.dev

# ─── web search (optional; falls back to DuckDuckGo scraping) ────────────────
# BRAVE_API_KEY=
# SERPER_API_KEY=

# ─── stored site logins for browser_act ──────────────────────────────────────
# VAULT_KEY=any-long-string-used-to-encrypt-the-vault

# ─── behaviour ───────────────────────────────────────────────────────────────
AGENT_MODEL=claude-sonnet-5
AGENT_TICK_MINUTES=5
CONSOLIDATE_HOUR_UTC=3
BRIEF_HOUR_UTC=5
DAILY_BRIEF=1
AUTO_APPROVE=0
# ENABLE_SHELL=1
